rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ─── Products ────────────────────────────────────────────────
    // Anyone can browse the catalogue. Only admins can mutate it.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Curation collections ────────────────────────────────────
    // Brands / gender / style tiles drive the home page — read-only for the public.
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /genderCollections/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /styleCollections/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Site settings ───────────────────────────────────────────
    // Single doc at settings/site. Public can read (announcement bar etc.),
    // only admins can change.
    match /settings/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Users ───────────────────────────────────────────────────
    // Users can read & update their own profile (display name, phone…).
    // The `role` field is admin-only — protected by the field-level check below.
    // Admins can read & write any user record.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        // New customers can only assign themselves the "customer" role.
        && (!('role' in request.resource.data) || request.resource.data.role == 'customer');
      allow update: if (isOwner(uid)
          // Self-updates may not change `role` to admin.
          && (!('role' in request.resource.data)
              || request.resource.data.role == resource.data.role))
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Order counter (sequential SA-prefixed IDs) ─────────────
    // The transaction in createOrder() reads + increments meta/orderCounter
    // atomically. Allowing read/write to anyone is fine: the counter only
    // controls *which* SA number the next order gets, not what data is
    // visible. Worst-case tampering = a number gets skipped, easily fixable
    // by editing the value in the Firestore console.
    match /meta/orderCounter {
      allow read, write: if true;
    }
    match /meta/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Orders ──────────────────────────────────────────────────
    // Customers may create their own order (tagged with their UID, or null for guests).
    // Customers can read only their own orders.
    // Guest orders (userId == null) are admin-only after creation.
    // Order status / tracking can only be updated by admins.
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if (
        // Guest order: userId must be null
        (!isSignedIn() && request.resource.data.userId == null)
        // Authenticated order: userId must be the caller
        || (isSignedIn() && request.resource.data.userId == request.auth.uid)
      ) && request.resource.data.status == 'pending';

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Mail queue (Firebase Trigger Email extension) ──────────
    // The extension watches this collection and dispatches anything
    // written to it via the configured SMTP provider. Allowing writes
    // from the client-side checkout/admin flow is acceptable because:
    //   - The collection is write-only from the client (no listing)
    //   - The extension itself imposes per-message size limits
    //   - The actual SMTP credentials live server-side in the extension
    match /mail/{id} {
      allow read: if isAdmin();
      allow create: if true;            // any flow that creates an order can queue mail
      allow update, delete: if isAdmin();
    }

    // ─── Newsletter ──────────────────────────────────────────────
    // Anyone can subscribe (write a new doc). Only admins can read the list.
    match /newsletter/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ─── Contact messages ────────────────────────────────────────
    // Anyone can submit. Only admins can read / triage.
    match /messages/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Default deny — anything not matched above is locked down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
